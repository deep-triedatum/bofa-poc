# /etc/verdaccio-seed/seed.env: settings for seed-registry.sh
REGISTRY_URL=http://172.31.47.239:4873/        # our registry; must match the host in AUTH_NPMRC exactly
UPSTREAM_URL=https://registry.npmjs.org/       # where missing packages are downloaded from
AUTH_NPMRC=/etc/verdaccio-seed/npmrc           # publish token for the registry (mode 600)
NODE_BIN=/opt/verdaccio/node/bin               # the registry's own pinned Node and npm
SEED_HOME=/var/lib/verdaccio-seed              # inbox, done, failed, reports, work
INTERNAL_SCOPES=@lab                           # never downloaded from upstream (comma list)
BLOCKLIST=/etc/verdaccio-seed/blocklist.txt    # versions that must never be loaded
SEED_OS=linux                                  # only native packages for these VMs (empty = all platforms)
SEED_CPU=x64
SEED_MODE=load                                 # inbox mode: load | list-only
