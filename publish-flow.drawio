<mxfile host="app.diagrams.net"><diagram name="Publish flow" id="publishflow1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2987" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;What happens when the user clicks Publish&lt;/font&gt;&lt;/b&gt;" id="c11"><mxCell style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="34" as="geometry" /></mxCell></UserObject><UserObject label="&lt;b&gt;How to read this.&lt;/b&gt; Each step has three boxes: &lt;b&gt;what happens&lt;/b&gt; (left), &lt;b&gt;the code that does it&lt;/b&gt; (middle: file and line, relative to &lt;i&gt;bofa-poc/&lt;/i&gt;; hover for the full path), and &lt;b&gt;what exists afterwards&lt;/b&gt; (right). Solid arrows are the order of events; dashed lines link a step to its code and result. &lt;b&gt;Where it runs:&lt;/b&gt; phase 1 in the browser; phases 2 to 4 on the VMs. Local disk is private to one VM; the shared volume (&lt;i&gt;/shared&lt;/i&gt;, EFS or NFS) is visible to both. Line numbers match the code at the time this was drawn." id="c12"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1300" height="62" as="geometry" /></mxCell></UserObject><UserObject label="&lt;b&gt;WHAT HAPPENS&lt;/b&gt;" id="c13"><mxCell style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="440" height="24" as="geometry" /></mxCell></UserObject><UserObject label="&lt;b&gt;THE CODE THAT DOES IT&lt;/b&gt;" id="c14"><mxCell style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="144" width="400" height="24" as="geometry" /></mxCell></UserObject><UserObject label="&lt;b&gt;WHAT EXISTS AFTERWARDS&lt;/b&gt;" id="c15"><mxCell style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="144" width="380" height="24" as="geometry" /></mxCell></UserObject><UserObject label="&lt;b&gt;1 &amp;middot; BROWSER &amp;mdash; the user clicks Publish&lt;/b&gt; &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#555555&quot; face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;builder/src/components/Header.tsx&lt;/font&gt;" id="c16"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="174" width="1300" height="34" as="geometry" /></mxCell></UserObject><UserObject label="&lt;b&gt;1. Fill in the Publish popover&lt;/b&gt;&lt;br&gt;App id (3&amp;ndash;40 chars: a&amp;ndash;z, 0&amp;ndash;9, dashes) and an optional AIT. The button stays disabled until the id has 3 characters. The page design is already in the Redux store as the component tree (&lt;i&gt;IComponents&lt;/i&gt;)." id="c17"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="440" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/src/components/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;Header.tsx:35&lt;/b&gt;&lt;/font&gt; PublishButton component&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;Header.tsx:128&lt;/b&gt;&lt;/font&gt; onClick={publish}" link="builder/src/components/Header.tsx" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/components/Header.tsx:35&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/components/Header.tsx:128" id="c18"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="230" width="400" height="82" as="geometry" /></mxCell></UserObject><UserObject label="Component tree: flat map {root, comp-1, &amp;hellip;}, each with type, props, children, parent" id="c19"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="230" width="380" height="82" as="geometry" /></mxCell></UserObject><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;2. POST /api/publish&lt;/b&gt;&lt;br&gt;fetch sends {components, appId, ait} as JSON. The request goes through the load balancer and lands on &lt;b&gt;any&lt;/b&gt; VM's proxy (:8080). The proxy sends every non-/apps path to the editor on :3000." id="c23"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="440" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/proxy/ &amp;middot; builder/src/components/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;Header.tsx:52&lt;/b&gt;&lt;/font&gt; fetch('/api/publish', { method: 'POST' })&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:99&lt;/b&gt;&lt;/font&gt; non-/apps path &amp;rarr; forward to the builder" link="builder/src/components/Header.tsx" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/components/Header.tsx:52&#10;/home/deeps/tdm-projects/bofa-poc/builder/proxy/server.js:99" id="c24"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="334" width="400" height="82" as="geometry" /></mxCell></UserObject><UserObject label="A long request: the proxy allows the builder 10 min (BUILDER_TIMEOUT_MS), nginx 600 s" id="c25"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="334" width="380" height="82" as="geometry" /></mxCell></UserObject><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c17" target="c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;2 &amp;middot; BUILDER API &amp;mdash; runs on whichever VM got the request&lt;/b&gt; &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#555555&quot; face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;builder/src/pages/api/publish.ts &amp;rarr; builder/src/server/publisher.ts&lt;/font&gt;" id="c29"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="438" width="1300" height="34" as="geometry" /></mxCell></UserObject><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c23" target="c29"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;3. Check the request&lt;/b&gt;&lt;br&gt;POST only (else 405). The body must contain components.root (else 400). The AIT defaults to DEFAULT_AIT, then &lt;i&gt;default&lt;/i&gt;." id="c31"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="494" width="440" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/src/pages/api/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publish.ts:12&lt;/b&gt;&lt;/font&gt; method check&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publish.ts:18&lt;/b&gt;&lt;/font&gt; components.root check&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publish.ts:25&lt;/b&gt;&lt;/font&gt; ait default" link="builder/src/pages/api/publish.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/pages/api/publish.ts:12&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/pages/api/publish.ts:18&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/pages/api/publish.ts:25" id="c32"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="494" width="400" height="82" as="geometry" /></mxCell></UserObject><UserObject label="Nothing is written yet" id="c33"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="494" width="380" height="82" as="geometry" /></mxCell></UserObject><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c29" target="c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;4. Validate the ids and take the per-app lock&lt;/b&gt;&lt;br&gt;appId and ait must match &lt;i&gt;^[a-z0-9][a-z0-9-]{2,39}$&lt;/i&gt; (else 400). If this app is already being published on this VM, answer 409. The lock is released in &lt;i&gt;finally&lt;/i&gt;, whatever happens." id="c37"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="598" width="440" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/src/server/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:86&lt;/b&gt;&lt;/font&gt; ID_PATTERN check&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:92&lt;/b&gt;&lt;/font&gt; inFlight lock (409)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:191&lt;/b&gt;&lt;/font&gt; finally: release the lock" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:86&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:92&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:191" id="c38"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="598" width="400" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;i&gt;inFlight&lt;/i&gt; set, in the builder's memory only" id="c39"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="598" width="380" height="82" as="geometry" /></mxCell></UserObject><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c31" target="c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;5. Pick the release number&lt;/b&gt;&lt;br&gt;The next integer after the highest folder in &lt;i&gt;&amp;lt;shared&amp;gt;/apps/&amp;lt;ait&amp;gt;/&amp;lt;appId&amp;gt;/releases/&lt;/i&gt; (1 for a new app). Old releases are never overwritten, so a rollback means pointing at an older folder." id="c43"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="702" width="440" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/src/server/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:100&lt;/b&gt;&lt;/font&gt; nextRelease(appDir)" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:100" id="c44"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="702" width="400" height="82" as="geometry" /></mxCell></UserObject><UserObject label="Release folder chosen. BASE_PATH = /apps/&amp;lt;appId&amp;gt;" id="c45"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="702" width="380" height="82" as="geometry" /></mxCell></UserObject><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c37" target="c43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;6. Generate the project files&lt;/b&gt;&lt;br&gt;&lt;i&gt;generateProject&lt;/i&gt; turns the component tree into a runnable Vite + React project: &lt;b&gt;App.jsx&lt;/b&gt; (via generateCode), package.json, vite.config.js (&lt;i&gt;base&lt;/i&gt; read from $BASE_PATH), index.html, main.jsx, &lt;b&gt;server.js&lt;/b&gt; (static server), &lt;b&gt;.npmrc&lt;/b&gt; (private registry), .env.build. Written to &lt;b&gt;local disk&lt;/b&gt;, not the shared volume." id="c49"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="440" height="112" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/src/server/ &amp;middot; builder/src/utils/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:109&lt;/b&gt;&lt;/font&gt; calls generateProject&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;project.ts:122&lt;/b&gt;&lt;/font&gt; generateProject()&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;code.ts:182&lt;/b&gt;&lt;/font&gt; generateCode(): tree &amp;rarr; JSX&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;project.ts:48&lt;/b&gt;&lt;/font&gt; vite.config template&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;project.ts:112&lt;/b&gt;&lt;/font&gt; .npmrc template" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:109&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/utils/project.ts:122&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/utils/code.ts:182&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/utils/project.ts:48&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/utils/project.ts:112" id="c50"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="806" width="400" height="112" as="geometry" /></mxCell></UserObject><UserObject label="Local: $BUILD_DIR/&amp;lt;appId&amp;gt;/&amp;lt;n&amp;gt;/ with package.json, src/App.jsx, server.js, &amp;hellip;" id="c51"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="806" width="380" height="112" as="geometry" /></mxCell></UserObject><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c43" target="c49"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c50" target="c51"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;7. npm install&lt;/b&gt;&lt;br&gt;&lt;i&gt;npm install --include=dev&lt;/i&gt; on local disk (thousands of small files are slow on NFS/EFS). The generated .npmrc sends packages through Artifactory when NPM_REGISTRY is set. &lt;i&gt;--include=dev&lt;/i&gt; is needed because the builder runs with NODE_ENV=production and Vite is a devDependency." id="c55"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="440" height="97" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/src/server/ &amp;middot; builder/src/utils/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:116&lt;/b&gt;&lt;/font&gt; run('npm', ['install', '--include=dev', &amp;hellip;])&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;project.ts:112&lt;/b&gt;&lt;/font&gt; registry line in .npmrc" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:116&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/utils/project.ts:112" id="c56"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="940" width="400" height="97" as="geometry" /></mxCell></UserObject><UserObject label="Local: node_modules/, package-lock.json" id="c57"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="940" width="380" height="97" as="geometry" /></mxCell></UserObject><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c49" target="c55"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c56" target="c57"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;8. npm run build&lt;/b&gt;&lt;br&gt;Vite builds with &lt;i&gt;BASE_PATH=/apps/&amp;lt;appId&amp;gt;&lt;/i&gt; in the environment, so every asset URL starts with that path. The generated code is not edited per deployment." id="c61"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1059" width="440" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/src/server/ &amp;middot; builder/src/utils/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:119&lt;/b&gt;&lt;/font&gt; run('npm', ['run', 'build'], env BASE_PATH)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;project.ts:48&lt;/b&gt;&lt;/font&gt; base: process.env.BASE_PATH" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:119&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/utils/project.ts:48" id="c62"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="1059" width="400" height="82" as="geometry" /></mxCell></UserObject><UserObject label="Local: dist/ (index.html, assets/*.js)" id="c63"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="1059" width="380" height="82" as="geometry" /></mxCell></UserObject><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c55" target="c61"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c61" target="c62"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c62" target="c63"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;9. Copy the release to the shared volume&lt;/b&gt;&lt;br&gt;Only what is needed to run: dist/, server.js, package.json, package-lock.json, .env.build. &lt;b&gt;No node_modules.&lt;/b&gt; The local build folder is then deleted." id="c67"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1163" width="440" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/src/server/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:133&lt;/b&gt;&lt;/font&gt; fs.cp loop over the five names" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:133" id="c68"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="1163" width="400" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;b&gt;Shared:&lt;/b&gt; apps/&amp;lt;ait&amp;gt;/&amp;lt;appId&amp;gt;/releases/&amp;lt;n&amp;gt;/ visible to every VM" id="c69"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="1163" width="380" height="82" as="geometry" /></mxCell></UserObject><mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c61" target="c67"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c67" target="c68"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c68" target="c69"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;10. Allocate a port on this VM&lt;/b&gt;&lt;br&gt;Reads the registry, collects the ports already claimed by apps on &lt;b&gt;this&lt;/b&gt; VM, then takes the first port in PORT_MIN&amp;ndash;PORT_MAX that is unclaimed and that it can actually bind to. Ports are per VM, so vm1 and vm2 can both use 20000." id="c73"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1267" width="440" height="127" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/runtime/ &amp;middot; builder/src/server/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:139&lt;/b&gt;&lt;/font&gt; lifecycle.readRegistry&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:148&lt;/b&gt;&lt;/font&gt; lifecycle.allocatePort&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;lifecycle.js:39&lt;/b&gt;&lt;/font&gt; allocatePort()&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;lifecycle.js:27&lt;/b&gt;&lt;/font&gt; isPortFree(): try to bind" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:139&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:148&#10;/home/deeps/tdm-projects/bofa-poc/builder/runtime/lifecycle.js:39&#10;/home/deeps/tdm-projects/bofa-poc/builder/runtime/lifecycle.js:27" id="c74"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="1267" width="400" height="127" as="geometry" /></mxCell></UserObject><UserObject label="A port, e.g. 20000 on vm1 (&lt;b&gt;not&lt;/b&gt; shared between VMs)" id="c75"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="1267" width="380" height="127" as="geometry" /></mxCell></UserObject><mxCell id="c76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c67" target="c73"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c73" target="c74"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c74" target="c75"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;11. Start the app&lt;/b&gt;&lt;br&gt;Runs &lt;i&gt;node server.js&lt;/i&gt; from the release folder, detached, with PORT and BASE_PATH set. Output goes to &lt;b&gt;app.log&lt;/b&gt; in the release folder. The app keeps running if the builder restarts." id="c79"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1416" width="440" height="97" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/runtime/ &amp;middot; builder/src/server/ &amp;middot; builder/src/utils/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:153&lt;/b&gt;&lt;/font&gt; lifecycle.startApp&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;lifecycle.js:75&lt;/b&gt;&lt;/font&gt; startApp(): spawn, detached&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;project.ts:79&lt;/b&gt;&lt;/font&gt; server.js template (what runs)" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:153&#10;/home/deeps/tdm-projects/bofa-poc/builder/runtime/lifecycle.js:75&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/utils/project.ts:79" id="c80"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="1416" width="400" height="97" as="geometry" /></mxCell></UserObject><UserObject label="Process: node server.js (pid). Log: releases/&amp;lt;n&amp;gt;/app.log" id="c81"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="1416" width="380" height="97" as="geometry" /></mxCell></UserObject><mxCell id="c82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c73" target="c79"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c79" target="c80"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c80" target="c81"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;12. Wait until it is healthy&lt;/b&gt;&lt;br&gt;Polls &lt;i&gt;GET /healthz&lt;/i&gt; on 127.0.0.1:&amp;lt;port&amp;gt; every 250 ms for up to 15 s. If it never answers, the new process is stopped, nothing is registered, and the user gets a 502." id="c85"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1535" width="440" height="97" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/runtime/ &amp;middot; builder/src/server/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:155&lt;/b&gt;&lt;/font&gt; waitHealthy; stopProcess on failure&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;lifecycle.js:63&lt;/b&gt;&lt;/font&gt; waitHealthy()&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;lifecycle.js:52&lt;/b&gt;&lt;/font&gt; probe(): one GET /healthz" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:155&#10;/home/deeps/tdm-projects/bofa-poc/builder/runtime/lifecycle.js:63&#10;/home/deeps/tdm-projects/bofa-poc/builder/runtime/lifecycle.js:52" id="c86"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="1535" width="400" height="97" as="geometry" /></mxCell></UserObject><UserObject label="/healthz answers &lt;i&gt;ok&lt;/i&gt;" id="c87"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="1535" width="380" height="97" as="geometry" /></mxCell></UserObject><mxCell id="c88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c79" target="c85"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c85" target="c86"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c86" target="c87"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;13. Register the app: the switch-over&lt;/b&gt;&lt;br&gt;Writes &lt;b&gt;registry/&amp;lt;appId&amp;gt;.json&lt;/b&gt; atomically (temp file, then rename): vm, ip, port, pid, release, basePath, status &lt;i&gt;running&lt;/i&gt;. Only now does the stable URL point at the new release. Then the previous release's process is stopped, if it ran on this VM." id="c91"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1654" width="440" height="127" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/runtime/ &amp;middot; builder/src/server/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:175&lt;/b&gt;&lt;/font&gt; lifecycle.writeRegistry&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;lifecycle.js:125&lt;/b&gt;&lt;/font&gt; writeRegistry()&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;lifecycle.js:118&lt;/b&gt;&lt;/font&gt; writeAtomic(): temp + rename&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:177&lt;/b&gt;&lt;/font&gt; stop the previous release" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:175&#10;/home/deeps/tdm-projects/bofa-poc/builder/runtime/lifecycle.js:125&#10;/home/deeps/tdm-projects/bofa-poc/builder/runtime/lifecycle.js:118&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:177" id="c92"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="1654" width="400" height="127" as="geometry" /></mxCell></UserObject><UserObject label="&lt;b&gt;Shared:&lt;/b&gt; registry/&amp;lt;appId&amp;gt;.json {vm, ip, port, pid, release, status}" id="c93"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="1654" width="380" height="127" as="geometry" /></mxCell></UserObject><mxCell id="c94" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c85" target="c91"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c95" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c91" target="c92"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c96" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c92" target="c93"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;14. Respond to the browser&lt;/b&gt;&lt;br&gt;&lt;i&gt;{ url, directUrl, release }&lt;/i&gt;. url = PUBLIC_BASE_URL + /apps/&amp;lt;appId&amp;gt;/ (the stable URL). directUrl = http://&amp;lt;VM_IP&amp;gt;:&amp;lt;port&amp;gt;/apps/&amp;lt;appId&amp;gt;/. Failures come back as {error} with 400, 409, 502, 503 or 500." id="c97"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1803" width="440" height="112" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/src/components/ &amp;middot; builder/src/pages/api/ &amp;middot; builder/src/server/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publisher.ts:183&lt;/b&gt;&lt;/font&gt; url / directUrl&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;publish.ts:28&lt;/b&gt;&lt;/font&gt; res.status(200).json(result)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;Header.tsx:59&lt;/b&gt;&lt;/font&gt; setResult(body)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;Header.tsx:108&lt;/b&gt;&lt;/font&gt; link: url if absolute, else directUrl" link="builder/src/server/publisher.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/server/publisher.ts:183&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/pages/api/publish.ts:28&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/components/Header.tsx:59&#10;/home/deeps/tdm-projects/bofa-poc/builder/src/components/Header.tsx:108" id="c98"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="1803" width="400" height="112" as="geometry" /></mxCell></UserObject><UserObject label="The popover shows &lt;i&gt;Release n is running: open application&lt;/i&gt;" id="c99"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="1803" width="380" height="112" as="geometry" /></mxCell></UserObject><mxCell id="c100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c91" target="c97"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c97" target="c98"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c98" target="c99"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;3 &amp;middot; THE USER OPENS THE URL &amp;mdash; through any VM's proxy&lt;/b&gt; &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#555555&quot; face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;builder/proxy/server.js&lt;/font&gt;" id="c103"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1937" width="1300" height="34" as="geometry" /></mxCell></UserObject><mxCell id="c104" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c97" target="c103"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;15. The request reaches a proxy&lt;/b&gt;&lt;br&gt;GET /apps/&amp;lt;appId&amp;gt;/&amp;hellip; arrives through the load balancer at either VM's proxy. A path matching /apps/&amp;lt;id&amp;gt;/&amp;hellip; is an app request; everything else goes to the editor." id="c105"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="1993" width="440" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/proxy/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:12&lt;/b&gt;&lt;/font&gt; APP_PATH regex&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:98&lt;/b&gt;&lt;/font&gt; match = APP_PATH.exec(pathname)" link="builder/proxy/server.js" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/proxy/server.js:12&#10;/home/deeps/tdm-projects/bofa-poc/builder/proxy/server.js:98" id="c106"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="1993" width="400" height="82" as="geometry" /></mxCell></UserObject><UserObject label="Which VM received it does not matter" id="c107"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="1993" width="380" height="82" as="geometry" /></mxCell></UserObject><mxCell id="c108" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c103" target="c105"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c109" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c105" target="c106"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c106" target="c107"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;16. Fix the trailing slash&lt;/b&gt;&lt;br&gt;/apps/&amp;lt;appId&amp;gt; with no slash gets a 308 redirect to /apps/&amp;lt;appId&amp;gt;/, because the app's assets live under that prefix." id="c111"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="2097" width="440" height="70" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/proxy/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:108&lt;/b&gt;&lt;/font&gt; 308 redirect" link="builder/proxy/server.js" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/proxy/server.js:108" id="c112"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="2097" width="400" height="70" as="geometry" /></mxCell></UserObject><UserObject label="Location: /apps/&amp;lt;appId&amp;gt;/?query" id="c113"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="2097" width="380" height="70" as="geometry" /></mxCell></UserObject><mxCell id="c114" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c105" target="c111"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c115" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c111" target="c112"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c112" target="c113"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;17. Look the app up in the registry&lt;/b&gt;&lt;br&gt;Reads &lt;i&gt;registry/&amp;lt;appId&amp;gt;.json&lt;/i&gt; from the shared volume, cached for 1 s (REGISTRY_CACHE_MS). No file &amp;rarr; 404. status not &lt;i&gt;running&lt;/i&gt; &amp;rarr; 503." id="c117"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="2189" width="440" height="70" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/proxy/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:26&lt;/b&gt;&lt;/font&gt; createLookup()&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:114&lt;/b&gt;&lt;/font&gt; status !== running &amp;rarr; 503" link="builder/proxy/server.js" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/proxy/server.js:26&#10;/home/deeps/tdm-projects/bofa-poc/builder/proxy/server.js:114" id="c118"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="2189" width="400" height="70" as="geometry" /></mxCell></UserObject><UserObject label="Entry {vm, ip, port}" id="c119"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="2189" width="380" height="70" as="geometry" /></mxCell></UserObject><mxCell id="c120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c111" target="c117"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c121" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c117" target="c118"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c122" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c118" target="c119"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;18. Forward to the VM that owns the app&lt;/b&gt;&lt;br&gt;Proxies the request, same path, to &lt;i&gt;&amp;lt;ip&amp;gt;:&amp;lt;port&amp;gt;&lt;/i&gt; from the entry: the same VM or the other one. Adds X-Forwarded-* headers. If the process is unreachable: 502, and the cached entry is dropped so the next request re-reads the registry." id="c123"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="2281" width="440" height="97" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/proxy/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:55&lt;/b&gt;&lt;/font&gt; forward()&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:125&lt;/b&gt;&lt;/font&gt; lookup.forget(appId) on error" link="builder/proxy/server.js" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/proxy/server.js:55&#10;/home/deeps/tdm-projects/bofa-poc/builder/proxy/server.js:125" id="c124"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="2281" width="400" height="97" as="geometry" /></mxCell></UserObject><UserObject label="Network hop, e.g. vm1 proxy &amp;rarr; vm2:20000" id="c125"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="2281" width="380" height="97" as="geometry" /></mxCell></UserObject><mxCell id="c126" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c117" target="c123"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c127" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c123" target="c124"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c128" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c124" target="c125"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;19. The app serves the page&lt;/b&gt;&lt;br&gt;server.js strips BASE_PATH, serves files from dist/, falls back to index.html for client-side routes, answers /healthz, and refuses paths outside dist/." id="c129"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="2400" width="440" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/src/utils/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;project.ts:79&lt;/b&gt;&lt;/font&gt; serverJs template, copied into every release" link="builder/src/utils/project.ts" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/src/utils/project.ts:79" id="c130"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="2400" width="400" height="82" as="geometry" /></mxCell></UserObject><UserObject label="The user sees the published page" id="c131"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="2400" width="380" height="82" as="geometry" /></mxCell></UserObject><mxCell id="c132" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c123" target="c129"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c133" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c129" target="c130"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c134" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c130" target="c131"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;4 &amp;middot; WHEN SOMETHING BREAKS &amp;mdash; the reconciler on every VM&lt;/b&gt; &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#555555&quot; face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;builder/reconciler/server.js&lt;/font&gt;" id="c135"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="2504" width="1300" height="34" as="geometry" /></mxCell></UserObject><mxCell id="c136" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c129" target="c135"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;20. Every interval: heartbeat and health check&lt;/b&gt;&lt;br&gt;Each VM writes &lt;i&gt;vms/&amp;lt;vm&amp;gt;.json&lt;/i&gt; (a timestamp), then GETs /healthz of every running app in the registry: local apps on 127.0.0.1, remote ones on their registered ip. Healthy apps are left alone." id="c137"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="2560" width="440" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/reconciler/ &amp;middot; builder/runtime/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:109&lt;/b&gt;&lt;/font&gt; tick()&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:110&lt;/b&gt;&lt;/font&gt; writeHeartbeat&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:132&lt;/b&gt;&lt;/font&gt; probe each app&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;lifecycle.js:128&lt;/b&gt;&lt;/font&gt; writeHeartbeat()" link="builder/reconciler/server.js" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/reconciler/server.js:109&#10;/home/deeps/tdm-projects/bofa-poc/builder/reconciler/server.js:110&#10;/home/deeps/tdm-projects/bofa-poc/builder/reconciler/server.js:132&#10;/home/deeps/tdm-projects/bofa-poc/builder/runtime/lifecycle.js:128" id="c138"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="2560" width="400" height="82" as="geometry" /></mxCell></UserObject><UserObject label="&lt;b&gt;Shared:&lt;/b&gt; vms/&amp;lt;vm&amp;gt;.json {updatedAt}" id="c139"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="2560" width="380" height="82" as="geometry" /></mxCell></UserObject><mxCell id="c140" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c135" target="c137"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c141" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c137" target="c138"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c142" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c138" target="c139"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;21. An app on this VM stopped answering&lt;/b&gt;&lt;br&gt;After FAILURES_BEFORE_RESTART failed checks in a row (default 2) it is restarted from its release on the shared volume: stop the old pid, try the same port first, start, wait for /healthz, re-read the registry to be sure nobody changed it, then write the new pid (restarts + 1)." id="c143"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="2664" width="440" height="112" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/reconciler/ &amp;middot; builder/runtime/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:149&lt;/b&gt;&lt;/font&gt; failure threshold&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:51&lt;/b&gt;&lt;/font&gt; start()&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:91&lt;/b&gt;&lt;/font&gt; sameEntry check before writing&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;lifecycle.js:39&lt;/b&gt;&lt;/font&gt; allocatePort(&amp;hellip;, preferred)" link="builder/reconciler/server.js" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/reconciler/server.js:149&#10;/home/deeps/tdm-projects/bofa-poc/builder/reconciler/server.js:51&#10;/home/deeps/tdm-projects/bofa-poc/builder/reconciler/server.js:91&#10;/home/deeps/tdm-projects/bofa-poc/builder/runtime/lifecycle.js:39" id="c144"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="2664" width="400" height="112" as="geometry" /></mxCell></UserObject><UserObject label="Registry: same ip:port, new pid, restarts + 1. The proxy follows within about 1 s" id="c145"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="2664" width="380" height="112" as="geometry" /></mxCell></UserObject><mxCell id="c146" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c137" target="c143"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c147" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c143" target="c144"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c148" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c144" target="c145"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="&lt;b&gt;22. A whole VM disappeared&lt;/b&gt;&lt;br&gt;The app's VM has no fresh heartbeat (VM_TIMEOUT_MS, default 20 s) and the app is not answering. Every live VM computes the same adopter: &lt;i&gt;sha1(appId)&lt;/i&gt; picks one of the sorted live VM names. That VM starts the app from the same release folder and rewrites vm / ip / port in the registry." id="c149"><mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="2798" width="440" height="127" as="geometry" /></mxCell></UserObject><UserObject label="&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;builder/reconciler/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:34&lt;/b&gt;&lt;/font&gt; pickAdopter()&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:142&lt;/b&gt;&lt;/font&gt; skip if the owner VM is live&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:154&lt;/b&gt;&lt;/font&gt; only the elected VM adopts&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b00020&quot;&gt;&lt;b&gt;server.js:51&lt;/b&gt;&lt;/font&gt; start(): same code as a restart" link="builder/reconciler/server.js" tooltip="/home/deeps/tdm-projects/bofa-poc/builder/reconciler/server.js:34&#10;/home/deeps/tdm-projects/bofa-poc/builder/reconciler/server.js:142&#10;/home/deeps/tdm-projects/bofa-poc/builder/reconciler/server.js:154&#10;/home/deeps/tdm-projects/bofa-poc/builder/reconciler/server.js:51" id="c150"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b00020;" vertex="1" parent="1"><mxGeometry x="520" y="2798" width="400" height="127" as="geometry" /></mxCell></UserObject><UserObject label="Registry: vm2 instead of vm1. &lt;b&gt;The URL does not change&lt;/b&gt;" id="c151"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="2798" width="380" height="127" as="geometry" /></mxCell></UserObject><mxCell id="c152" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c143" target="c149"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c153" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c149" target="c150"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c154" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=oval;endFill=1;strokeColor=#888888;" edge="1" parent="1" source="c150" target="c151"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>