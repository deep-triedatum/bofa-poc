# /etc/builder/builder.env: read by the builder, proxy and reconciler services.
# bootstrap.sh writes this file with VM_NAME and VM_IP filled in. Edit it, then:
#   sudo systemctl restart builder proxy reconciler

# the shared EFS mount, identical on every VM
SHARED_DIR=/mnt/shared
# local disk for npm install and builds (never the shared volume)
BUILD_DIR=/var/tmp/builder-builds

# this VM
VM_NAME=__VM_NAME__
VM_IP=__VM_IP__
PORT_MIN=20000
PORT_MAX=20999

# proxy
PROXY_PORT=8080
BUILDER_URL=http://127.0.0.1:3000

# the address users type: an ALB or DNS name in front of both VMs, or http://<a VM's address>:8080
PUBLIC_BASE_URL=http://__VM_IP__:8080

# reconciler (defaults shown)
RECONCILE_INTERVAL_MS=5000
VM_TIMEOUT_MS=20000
FAILURES_BEFORE_RESTART=2

# default AIT when a publish request has none
DEFAULT_AIT=default

# private npm registry for the generated apps' installs. Empty: the public registry.
NPM_REGISTRY=

# no calls to external services
NEXT_TELEMETRY_DISABLED=1
