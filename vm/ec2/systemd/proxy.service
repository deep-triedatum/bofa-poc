[Unit]
Description=Builder proxy (stable /apps/<appId>/ URLs)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/shared

[Service]
User=builder
Group=builder
WorkingDirectory=/opt/builder/current
EnvironmentFile=/etc/builder/builder.env
ExecStart=/usr/bin/env node proxy/server.js
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
