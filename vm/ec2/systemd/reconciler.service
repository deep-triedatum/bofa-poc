[Unit]
Description=Builder reconciler (restarts and adopts published apps)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/shared

[Service]
User=builder
Group=builder
WorkingDirectory=/opt/builder/current
EnvironmentFile=/etc/builder/builder.env
ExecStart=/usr/bin/env node reconciler/server.js
Restart=always
RestartSec=2
# apps it starts must survive a restart of the reconciler
KillMode=process

[Install]
WantedBy=multi-user.target
